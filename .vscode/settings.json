{
  // ===== LaTeX Workshop =====
  // 只写命令名, 不写绝对路径, 保证在每台电脑上都能用
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-shell-escape",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOCFILE%"],
      "env": {}
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex x2",
      "tools": ["xelatex", "xelatex"]
    },
    {
      "name": "xelatex x1 (快速预览)",
      "tools": ["xelatex"]
    },
    {
      "name": "xelatex -> biber -> xelatex x2 (含参考文献)",
      "tools": ["xelatex", "biber", "xelatex", "xelatex"]
    }
  ],

  // 保存即编译
  "latex-workshop.latex.autoBuild.run": "onSave",

  // 强制使用上面定义的 recipe。
  // 否则 main.tex 顶部的 "% !TeX program = xelatex" 魔法注释会让扩展
  // 绕过 recipe 直接调 xelatex, 结果只编译一遍, 交叉引用永远是 ??,
  // 而且 -shell-escape 参数会丢失。
  "latex-workshop.latex.build.forceRecipeUsage": true,

  // 编译后清理中间文件。
  // 注意: 清理列表里绝不能放 *.synctex.gz, 那是正反向跳转的索引,
  // 删掉之后 Ctrl+左键 和 Ctrl+Alt+J 都会失效。
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.blg", "*.idx", "*.ind", "*.lof", "*.lot",
    "*.out", "*.toc", "*.acn", "*.acr", "*.alg", "*.glg", "*.glo",
    "*.gls", "*.fls", "*.fdb_latexmk", "*.snm", "*.nav",
    "*.run.xml", "*.bcf"
  ],

  // 内置标签页预览, 支持正向反向跳转
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,

  // 只把错误显示成红色波浪线, 警告太多会刷屏
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": false,

  // ===== 编辑体验 =====
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2,
    "editor.formatOnSave": false,
    "editor.suggestSelection": "recentlyUsed"
  },

  "files.encoding": "utf8",
  "files.eol": "\n"
}
